# Copy this file to .env in the repository root, next to compose.yaml.
# Run all Docker Compose commands from that directory; .env is loaded automatically.
# Compose does not load .env.example, scan .local/, or read a raw key file automatically.
# Keep this template credential-free. Private files are ignored by Git and Docker builds.

# Required on a NEW database: replace with a random password using letters, digits, '-' and '_'.
# Existing database: keep the original password; changing this value does not rotate it.
POSTGRES_PASSWORD=replace-with-a-local-random-password
CONSOLE_PORT=5173
# New machine: build local images first. Use an immutable SHA only when those images exist.
CANDIDATE_SHA=local
# Docker persists downloads in media-data and the databases in postgres-data.
MEDIA_RETENTION_DAYS=30

# Real AI: fill OPENAI_API_KEY and select a model available to that key/provider.
# openai is the adapter mode for compatible APIs, including DeepSeek.
# Missing key with AGENT_MODE=openai refuses Agent startup; it does NOT fall back to scripted.
# For a no-key UI demo only, explicitly choose AGENT_MODE=scripted (fixed replies, not real AI).
AGENT_MODE=openai
OPENAI_API_STYLE=chat_completions
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_API_KEY=
# Put only the key value above, not a filename. Use single quotes if it contains '$' or '#'.
# The base URL must not include /chat/completions; the provider appends the endpoint.
# These OPENAI_* values go only to agent. Group replies also require an online bound admin,
# Agent enabled, marketing active, and a NEW external-member message.

# Apply AI config changes (do not use restart to reload env):
# docker compose -p kapibala-demo up -d --no-build --no-deps agent
# Compose creates both databases, runs migrations and sets internal service URLs automatically.
# Gateway is Telegram-only. New databases contain no accounts; upload Session + JSON in the console.
# Native Go/Vite and isolated test database settings are documented in docs/getting-started.md;
# they are not needed for Docker Compose. Never use a live account database for tests.
