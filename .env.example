# Copy to ignored .env for Compose; keep private configuration at repository root or .local/.
# Use a URI-safe random PostgreSQL password (letters, digits, '-' and '_').
POSTGRES_PASSWORD=replace-with-a-local-random-password
CONSOLE_PORT=5173
# CI writes the exact 40-character commit SHA; local development defaults to local.
CANDIDATE_SHA=local

# Native execution: create two separate, dedicated databases first.
E2E_DATABASE_URL=postgres://kapibala@127.0.0.1:55432/kapibala_e2e?sslmode=disable
E2E_GATEWAY_DATABASE_URL=postgres://kapibala@127.0.0.1:55432/kapibala_gateway_e2e?sslmode=disable
# Backend integration: TEST_DATABASE_URL; gateway integration: GATEWAY_TEST_DATABASE_URL.
# Tests must not use a database containing live accounts or Sessions.
# Native browser tests: BACKEND_PORT=18080, GATEWAY_PORT=18081, AGENT_PORT=18082.

# Real provider settings belong only in the provider process's private environment.
# Compose forwards these four OPENAI_* values only to the provider service.
# AGENT_MODE defaults to scripted. Set openai for real automatic replies in enabled groups.
# AI script generation requires a real key even when AGENT_MODE is scripted.
# AGENT_MODE=openai
# OPENAI_API_STYLE=chat_completions
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash
# OPENAI_API_KEY=  (fill in ignored local configuration; never commit a real key)
# Gateway is Telegram-only. New databases contain no accounts; upload Session + JSON in the console.
# Existing manifest-backed installations require the documented offline credential adoption first.
